#!/sbin/openrc-run

description="Stasher home inventory server"

# ---- EDIT ME ------------------------------------------------------------
# Binary, config file, and the user:group the service runs as. The data
# directory (SQLite DB + uploaded files) is resolved relative to data_dir in
# the config (default ./data, relative to the config file's directory),
# or the STASHER_DATA_DIR environment variable. Make sure that user can
# write to it.
command="/home/USERNAME/stasher"
command_args="-config /home/USERNAME/stasher.yaml"
command_user="stasher:stasher"
# -------------------------------------------------------------------------

supervisor=supervise-daemon
output_log="/var/log/stasher.log"
error_log="/var/log/stasher.err.log"

depend() {
	need localmount
	after firewall
}
