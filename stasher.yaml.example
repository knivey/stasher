# Stasher configuration example.
# Copy to stasher.yaml and edit:  cp stasher.yaml.example stasher.yaml
# Run with:                       ./stasher -config stasher.yaml
#
# Every key can be overridden by environment variables:
#   STASHER_LISTEN_ADDR, STASHER_BASE_URL, STASHER_DATA_DIR,
#   STASHER_REGISTRATION, STASHER_LOG_LEVEL, STASHER_TRASH_RETENTION_DAYS,
#   STASHER_CHROME_PATH, STASHER_BRAVE_API_KEY,
#   STASHER_AI_API_KEY, STASHER_AI_BASE_URL, STASHER_AI_MODEL

# Address the server listens on. Behind a reverse proxy (Caddy/nginx),
# keep this on localhost and proxy to it.
listen_addr: "127.0.0.1:8080"

# Public URL of the deployment (used for external references/links).
base_url: "https://stasher.example.com"

# Where the SQLite database and uploaded files live. Back this up.
data_dir: "./data"

# Registration mode:
#   invite - new accounts require an invite code created by an admin
#            (default; recommended for internet-facing deployments)
#   open   - anyone can register
# The FIRST user to register becomes admin and never needs an invite code,
# regardless of mode. Register the admin account immediately after first
# start (see README "First-run security").
registration: "invite"

# Log level: debug | info (default) | warn | error
log_level: "info"

# How many days trashed items are kept before being purged permanently.
# 0 disables automatic purging (trash keeps until manually emptied).
trash_retention_days: 30

# Optional: path to a chromium/chrome binary for the page archiver
# (item product pages → PDF). Empty = auto-detect chromium,
# chromium-browser, or google-chrome on PATH. Without it, direct URL
# fetching still works; archiving returns a helpful error.
chrome_path: ""

# Optional: Brave Search API key for the document finder
# (free tier: https://api-dashboard.search.brave.com). Empty disables
# search. With a key, "Find document…" on an item searches the web for
# candidate datasheets and returns only URLs that verify as downloadable
# PDFs; picking one downloads it through the normal fetch endpoint.
brave_api_key: ""

# Optional: AI autofill ("Autofill from photos" on the add/edit item
# form) via an OpenAI-compatible chat-completions service. Empty
# ai_api_key disables the feature (default). ai_model is required when
# the key is set — there is no default, a wrong-vendor model name
# errors confusingly. ai_base_url lets you point at OpenRouter, Groq,
# or a local ollama/vLLM server instead of OpenAI
# (default https://api.openai.com/v1; ollama http://localhost:11434/v1).
# Enabling sends item photos to the configured AI service.
#ai_api_key: ""
#ai_base_url: "https://api.openai.com/v1"
#ai_model: ""
